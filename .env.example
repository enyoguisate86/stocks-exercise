# Market data source: yfinance (default, live Yahoo Finance data) or mock (offline fictional fixtures).
STOCK_PROVIDER=yfinance

# Optional LLM support. Leave blank to use the deterministic offline fallback.
STOCK_LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL="qwen/qwen3.8-27b"
